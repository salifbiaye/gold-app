    {
      "name": "5. Webhook notification - Exemple payload",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"PAIEMENT_RECU\",\n  \"txId\": \"{{reference_label}}\",\n  \"end2endId\": \"{{end2end_id}}\",\n  \"montant\": {{montant_paiement}},\n  \"aliasTresor\": \"{{tresor_alias}}\",\n  \"client\": \"Client Test\",\n  \"motif\": \"{{motif}}\",\n  \"dateIrrevocabilite\": \"{{date_irrevocabilite}}\",\n  \"refInterne\": null\n}"
        },
        "url": {
          "raw": "{{webhook_url}}",
          "host": [
            "{{webhook_url}}"
          ]
        },
        "description": "Exemple de payload webhook a envoyer vers une URL que vous exposez. Pour un QR, si refInterne est null et status = PAIEMENT_RECU, txId correspond au Reference Label."
      }

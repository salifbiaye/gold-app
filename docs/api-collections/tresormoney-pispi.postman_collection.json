              "pm.environment.set('demande_tx_id', json.txId);"
            ]
          }
        }
      ]
    },
    {
      "name": "3b. Demande de paiement CASH-IN - Initier minimal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },

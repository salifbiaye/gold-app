          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"txId\": \"{{paiement_tx_id}}\",\n  \"confirmation\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/ats-ws/api/ats-service/paiements/confirmations",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "ats-ws",
            "api",
            "ats-service",
            "paiements",
            "confirmations"
          ]
        },
        "description": "Confirme le paiement initie. Reponse attendue: statut = ENVOYE A PI-SPI."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Paiement confirmation HTTP 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('statut envoye', function () {",
              "  pm.expect(json.statut).to.eql('ENVOYE A PI-SPI');",
              "});"
            ]
          }
        }
      ]
    },

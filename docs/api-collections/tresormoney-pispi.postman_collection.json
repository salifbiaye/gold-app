            "api",
            "ats-service",
            "demandes-paiements"
          ]
        },
        "description": "Variante minimale pour isoler les erreurs CASH-IN. Elle retire les champs optionnels motif/refDocNumero/refDocType et utilise une refInterne unique."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Demande init minimal HTTP 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "if (json.txId) {",
              "  pm.environment.set('demande_tx_id', json.txId);",
              "}"
            ]
          }
        }
      ]
    },
